# Copy this file to ".env" (same directory you run the commands from) and fill in the values.

# ===================== SPOTIFY =====================
# 1. https://developer.spotify.com/dashboard -> "Create app"
#    (the app owner needs Spotify Premium - Spotify rule since Feb 2026)
# 2. Redirect URI (exactly):  http://127.0.0.1:43019/redirect
# 3. APIs used: check "Web API" -> Save
# 4. Open the app -> Settings -> copy the "Client ID" below (Client Secret is NOT needed)
SPOTIFY_CLIENT_ID=

# ================== YOUTUBE MUSIC ==================
# 1. Open https://music.youtube.com logged in
# 2. F12 -> Network tab -> filter by "browse" -> click any request (reload the page if empty)
# 3. Under "Request Headers", copy the WHOLE value of the "cookie" header and paste it below, on one line
#    (it must contain __Secure-3PAPISID; no quotes and no "cookie:" prefix)
YTMUSIC_COOKIE=
# Value of the "x-goog-authuser" header from the same request (0 if only one Google account is logged in)
YTMUSIC_AUTHUSER=0
